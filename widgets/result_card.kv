<ResultCard>:
    orientation: "vertical"
    size_hint_y: None
    height: "520dp"

    MDCard:
        orientation: "vertical"
        padding: "12dp"
        spacing: "8dp"
        radius: [20, 20, 20, 20]
        elevation: 5
        size_hint_y: 1

        MDLabel:
            text: "ABG Report"
            halign: "center"
            bold: True
            font_size: "20sp"
            size_hint_y: None
            height: "38dp"

        MDSeparator:
            size_hint_y: None
            height: "1dp"

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            bar_width: "4dp"

            MDBoxLayout:
                id: report_container
                orientation: "vertical"
                spacing: "10dp"
                padding: "4dp"
                size_hint_y: None
                height: self.minimum_height