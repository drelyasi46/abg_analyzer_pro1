from kivymd.uix.card import MDCard
from kivymd.uix.label import MDLabel


class ResultCard(MDCard):

    def __init__(self, **kwargs):
        super().__init__(
            orientation="vertical",
            padding="16dp",
            radius=[16, 16, 16, 16],
            elevation=2,
            **kwargs
        )

        self.label = MDLabel(
            text="Enter ABG values and press ANALYZE ABG.",
            halign="left",
            valign="top",
            size_hint_y=None,
            markup=False,
            padding=(4, 4),
        )

        self.label.bind(width=self._update_text_width)
        self.label.bind(texture_size=self._update_height)

        self.add_widget(self.label)

    def _update_text_width(self, instance, width):
        instance.text_size = (max(width - 8, 1), None)

    def _update_height(self, instance, value):
        instance.height = max(value[1] + 8, 200)

    def set_report(self, report):
        self.label.text = str(report)
